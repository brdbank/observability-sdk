// ============================================================
// Grafana Alloy — fallback log pipeline
// Reads PM2 log files and ships to Loki
// Tagged with pipeline="file" for deduplication with OTLP primary
// ============================================================

// --- Discovery: find all PM2 log files ---
local.file_match "pm2_logs" {
  path_targets = [{
    "__path__" = "/pm2-logs/*.log",
    "pipeline"  = "file",
  }]
  sync_period = "5s"
}

// --- Read matched log files ---
loki.source.file "pm2" {
  targets    = local.file_match.pm2_logs.targets
  forward_to = [loki.process.pm2_pipeline.receiver]
}

// --- Process: extract service name from PM2 filename and parse JSON ---
loki.process "pm2_pipeline" {
  // PM2 log filenames follow: <process-name>-out.log / <process-name>-error.log
  // Extract service name from filename
  stage.regex {
    source     = "filename"
    expression = `/pm2-logs/(?P<pm2_process>[^-]+(?:-[^-]+)*?)(?:-out|-error)\.log$`
  }

  stage.labels {
    values = {
      "pm2_process" = "",
    }
  }

  // Try to parse JSON logs (SDK structured output)
  stage.json {
    expressions = {
      "level"        = "level",
      "service_name" = "service_name",
      "trace_id"     = "trace_id",
      "span_id"      = "span_id",
      "msg"          = "msg",
    }
  }

  // Use service_name from JSON if available, else fallback to pm2_process
  stage.label_drop {
    values = ["filename"]
  }

  stage.labels {
    values = {
      "level"        = "",
      "service_name" = "",
    }
  }

  // Static label: this came from file pipeline
  stage.static_labels {
    values = {
      "pipeline" = "file",
    }
  }

  forward_to = [loki.write.default.receiver]
}

// --- Write to Loki ---
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
